// Si no está definido anteriormente, se crea. (para evitas muchas inclusiones del mismo archivo)
// If it hasn't been defined previously, it is created. (to avoid multiple inclusions of the same file)
#ifndef CORE_INC_DRV_MOTOR_H_
#define CORE_INC_DRV_MOTOR_H_

#include "tim.h"
#include "gpio.h"

// Definición de los límites de velocidad (0 a 8399)
// Definition of speed limits (0 to 8399)

#define MOTOR_MAX_SPEED 8399
#define MOTOR_MIN_SPEED -8399

typedef struct {
    TIM_HandleTypeDef* htim;    // Timer PWM -
    uint32_t channel;           // Canal PWM -

    GPIO_TypeDef* port_a;       // Dirección puerto A
    uint16_t pin_a;             // Dirección Pin A

    GPIO_TypeDef* port_b;       // Dirección puerto B
    uint16_t pin_b;             // Dirección Pin B

    int16_t current_speed;      // Estado actual (-8399 to 8399)
} MotorHandle_t;

/**
 * @brief Inicializa el motor PWM.
 */
void Motor_Init(MotorHandle_t* motor);

/**
 * @brief Inicializa la función para setear la velocidad.
 * @param speed - Valor de la velocidad entre -8399 y 8399.
 */
void Motor_SetSpeed(MotorHandle_t* motor, int16_t speed);

/**
 * @brief Inicializa la función para parar el motor.
 */
void Motor_Stop(MotorHandle_t* motor);

#endif CORE_INC_DRV_MOTOR_H_
