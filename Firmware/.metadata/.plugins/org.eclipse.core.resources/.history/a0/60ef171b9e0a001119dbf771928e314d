#ifndef CORE_INC_DRV_MOTOR_H_
#define CORE_INC_DRV_MOTOR_H_

// Definiciones para limites de velocidad (0 a 1000)
#define MOTOR_MAX_SPEED 1000
#define MOTOR_MIN_SPEED -1000

typedef struct {
    TIM_HandleTypeDef* htim;    // Timer del PWM (ej. &htim4)
    uint32_t channel;           // Canal (ej. TIM_CHANNEL_1)

    GPIO_TypeDef* port_a;       // Puerto Pin Direccion A
    uint16_t pin_a;             // Pin Direccion A

    GPIO_TypeDef* port_b;       // Puerto Pin Direccion B
    uint16_t pin_b;             // Pin Direccion B

    int16_t current_speed;      // Estado actual (-1000 a 1000)
} MotorHandle_t;

/**
 * @brief Inicializa el PWM del motor.
 */
void Motor_Init(MotorHandle_t* motor);

/**
 * @brief Establece la velocidad del motor.
 * @param speed Valor entre -1000 (atras) y 1000 (adelante). 0 es freno.
 */
void Motor_SetSpeed(MotorHandle_t* motor, int16_t speed);

/**
 * @brief Detiene el motor inmediatamente.
 */
void Motor_Stop(MotorHandle_t* motor);

#endif /* CORE_INC_DRV_MOTOR_H_ */
