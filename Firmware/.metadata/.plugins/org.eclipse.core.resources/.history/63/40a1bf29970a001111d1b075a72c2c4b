#ifndef CORE_INC_DRV_ULTRASOUND_H_
#define CORE_INC_DRV_ULTRASOUND_H_

#include "stm32f4xx_hal.h"

typedef struct {
    GPIO_TypeDef* trig_port;
    uint16_t trig_pin;
    GPIO_TypeDef* echo_port;
    uint16_t echo_pin;
    TIM_HandleTypeDef* timer; // Timer para medir microsegundos (ej. TIM2)
} Ultrasound_t;

/**
 * @brief Inicializa el sensor (asegúrate de que el timer esté configurado a 1MHz)
 */
void Ultrasound_Init(Ultrasound_t* dev);

/**
 * @brief Realiza una lectura y devuelve la distancia en milímetros.
 * @return Distancia en mm. Retorna 0 si hay error o fuera de rango.
 */
uint32_t Ultrasound_Read_mm(Ultrasound_t* dev);

#endif /* CORE_INC_DRV_ULTRASOUND_H_ */
